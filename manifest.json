{
  "manifest_version": 3,
  "name": "Sandpaper",
  "version": "1.0.4",
  "description": "Make the news a safer place 🙂",
  "permissions": [],
  "host_permissions": [
    "https://www.wsj.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.wsj.com/*"],
      "js": ["filterContent.js", "filterSection.js", "filterVideo.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}