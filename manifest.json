{
  "manifest_version": 3,
  "name": "Sandpaper",
  "version": "1.2.7",
  "description": "Make the news a safer place 🙂",
  "permissions": [],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://phys.org/*"],
      "js": [
        "util.js",
        "phys.org/filterPaywall.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.reuters.com/*",
        "https://reuters.com/*"
      ],
      "js": [
        "util.js",
        "reuters.com/stopAutoplay.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.wsj.com/*"],
      "js": [
        "util.js",
        "wsj.com/filterAdBlockerDetector.js",
        "wsj.com/filterAdWrapper.js",
        "wsj.com/filterGrid.js",
        "wsj.com/filterHeadlines.js",
        "wsj.com/filterSection.js",
        "wsj.com/filterWords.js",
        "wsj.com/stopAutoplay.js",
        "wsj.com/documentBg.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://xhamsterlive.com/*"],
      "js": [
        "util.js",
        "xhl.com/filterPlugins.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}